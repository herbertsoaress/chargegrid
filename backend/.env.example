# ============================================================
# ChargeGrid backend - variaveis de ambiente
# Copie este arquivo para ".env" (mesma pasta) e preencha.
# O ".env" NUNCA vai para o Git (ja esta no .gitignore).
# ============================================================

# "development" cria as tabelas sozinho (SQLite/dev). "production" NAO cria tabelas
# (o schema vem da migration do Supabase) e exige uma SECRET_KEY propria.
APP_ENV=development

# ---------------- Banco de dados ----------------
# Padrao: SQLite local (arquivo chargegrid.db). Bom para desenvolver sem internet.
DATABASE_URL=sqlite:///./chargegrid.db

# SUPABASE (Postgres): comente a linha acima e use a connection string do painel:
#   Supabase -> seu projeto "chargegrid" -> botao "Connect" -> "Connection string" -> URI
#   - Rodando na sua maquina/IPv6:  "Direct connection"
#   - Rodando no Render/Railway (IPv4): use o "Session pooler"
# Troque [SUA-SENHA] pela senha do banco (Project Settings -> Database -> Reset database password).
# Se a senha tiver caracteres especiais (@ : / #), codifique-os (ex.: @ vira %40).
# DATABASE_URL=postgresql://postgres.mnwbfokesysinsxovwkx:[SUA-SENHA]@<host-do-pooler>:5432/postgres

# ---------------- Seguranca ----------------
# Chave que assina os tokens de login. Gere uma longa e aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Sites autorizados a chamar a API (CORS), separados por virgula, SEM barra no final.
# Em producao coloque a URL do frontend publicado (ex.: https://chargegrid.vercel.app).
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080

# E-mails que viram OPERADOR ao se cadastrar (todo o resto vira motorista).
OPERATOR_EMAILS=

# ---------------- Modo demonstracao ----------------
# Cria as contas operador@chargegrid.demo / motorista@chargegrid.demo (senha chargegrid123)
SEED_DEMO_DATA=true
# Libera POST /auth/demo-login (entra sem senha). O app Lovable usa isto. DESLIGUE se o
# backend ficar publico depois da banca.
ALLOW_DEMO_LOGIN=true

# ---------------- Simulacao ----------------
# Sessao aberta ha mais de X minutos e encerrada sozinha quando alguem pede o mesmo carregador
SESSION_TTL_MINUTES=120
# 1 = tempo real. 60 = cada minuto real vale 1 hora de recarga (bom para demonstrar).
SIM_TIME_SCALE=1

# ---------------- Cenario do local e modelo de previsao ----------------
# SUPOSICOES de cenario (nao sao medicoes): potencia contratada e carga do predio.
# Sobra (contratada - predio) para os carros; o modelo de preco usa essa capacidade.
SITE_CONTRACTED_KW=200
SITE_BASE_LOAD_KW=120
# Ocupacao de um dia util ao meio-dia (0 a 1). Maior = preco mais alto nos picos.
PEAK_OCCUPANCY_REF=0.80
# A partir desta ocupacao prevista o painel avisa "saturacao prevista".
SATURATION_THRESHOLD=0.90
# CSV que treina o modelo (relativo a pasta backend). Trocou o arquivo? Clique em "Retreinar modelo".
FORECAST_CSV_PATH=data/fase1-base_de_dados-final.csv

# ---------------- GoodWe OpenAPI (opcional) ----------------
# Deixe vazio enquanto a FIAP/GoodWe nao liberar as credenciais: o adaptador SIMULADO e usado
# e todas as respostas vem marcadas como origem="simulado".
GOODWE_APP_ID=
GOODWE_APP_SECRET=
GOODWE_BASE_URL=https://us.semsportal.com

# ---------------- Assistente com IA (Gemini) ----------------
# Cole aqui a chave do Google AI Studio (https://aistudio.google.com/apikey). Ela fica SO neste
# arquivo -- nunca no frontend, nunca no Git. Vazia = o assistente responde por regras.
GEMINI_API_KEY=
# Modelo usado. O Google aposenta modelos antigos (o gemini-2.5-flash ja nao aceita contas novas);
# se aparecer "HTTP 404" na auditoria, troque por um modelo "flash" atual.
GEMINI_MODEL=gemini-3.6-flash
# Perguntas por minuto por usuario que podem ir para a IA (protege a cota da chave).
AI_RATE_LIMIT_PER_MINUTE=20

# ---------------- Pagamento ----------------
# "sandbox" = aprovacao simulada (nenhuma cobranca real). Para um provedor real, veja services/payments.py.
PAYMENT_PROVIDER=sandbox

# ---------------- OCPP 1.6J (protocolo aberto dos carregadores) ----------------
# O backend e o CSMS: carregadores conectam em ws://HOST/ocpp/<codigo>, ex.: ws://localhost:8000/ocpp/CG-001
OCPP_ENABLED=true
# Senha compartilhada (HTTP Basic, usuario = codigo do carregador). Vazio = sem senha (so em desenvolvimento).
OCPP_SHARED_TOKEN=
# Carregadores VIRTUAIS (hardware simulado): ligam sozinhos e falam OCPP de verdade com este backend.
OCPP_SIMULATOR=false
OCPP_SIMULATOR_URL=ws://127.0.0.1:8000
# 60 = cada segundo real vale 1 minuto de recarga (bom para demonstrar)
OCPP_SIMULATOR_SPEEDUP=60

# ---------------- MODBUS TCP (medidor de energia SIMULADO) ----------------
# Sobe um medidor virtual (porta MODBUS_PORT) e o backend le os registradores como se fosse um medidor real.
MODBUS_SIMULATOR=false
MODBUS_PORT=5020
