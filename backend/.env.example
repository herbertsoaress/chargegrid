# Banco de dados. Default: SQLite local (zero config).
# Para Postgres/Supabase: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./chargegrid.db

# JWT
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GoodWe OpenAPI (opcional). Sem estas variaveis o adaptador simulado e usado
# automaticamente e todas as respostas de /goodwe/* trazem origem="simulado".
# Preencher somente apos autorizacao da FIAP/GoodWe (ver Etapa 0 da proposta).
GOODWE_APP_ID=
GOODWE_APP_SECRET=
GOODWE_BASE_URL=https://us.semsportal.com

# CORS
FRONTEND_ORIGIN=http://localhost:5173
